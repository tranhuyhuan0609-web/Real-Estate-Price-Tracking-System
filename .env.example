# Real Estate Price Tracking System - settings read by realestate.infrastructure.config.Settings
# Copy to .env. tests/contract/test_env_example.py fails if this list drifts from Settings.
# Host/port values target the ports published by docker/docker-compose.yml, for running
# the CLI / workers from the host. Containers override the hosts themselves.

# Logging (DEBUG | INFO | WARNING | ERROR)
CRAWLER_LOG_LEVEL=INFO

# PostgreSQL - Silver & Gold layers
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=16103
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=realestate_db

# MongoDB - Bronze layer + DLQ archive
MONGO_HOST=127.0.0.1
MONGO_PORT=16102
MONGO_USER=mongo_user
MONGO_PASSWORD=change_me
MONGO_DB=realestate_raw

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:16100
KAFKA_RAW_TOPIC=realestate.raw_events
KAFKA_DLQ_TOPIC=realestate.dlq_events

# Kafka consumer groups - one per pipeline stage; raw writer and clean processor must differ
KAFKA_GROUP_RAW_WRITER=bds_bronze_mongo_group
KAFKA_GROUP_CLEAN_PROCESSOR=bds_silver_gold_pg_group
KAFKA_GROUP_DLQ_WRITER=bds_dlq_writer_group

# Kafka transport security (PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL). Use SASL_SSL for
# any broker reachable outside a private network; SASL needs username + password.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Observability: Prometheus /metrics port per process (0 = off) and heartbeat file directory
METRICS_PORT=0
HEARTBEAT_DIR=/tmp

# Telegram alerts (Alertmanager, `make up-monitoring`). 1) create a bot with @BotFather and paste
# its token; 2) open the bot and press Start; 3) `uv run realestate telegram-chat-id` prints the id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backups (pg-backup / mongo-backup services write to ./backups). The scheduler reads this
# directory (mounted at /backups in compose) to alert when backups stop. Empty = no check.
BACKUP_DIR=
