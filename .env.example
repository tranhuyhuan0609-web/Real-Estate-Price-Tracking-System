# ==========================================
# Real Estate Price Tracking System - Configuration Template
# ==========================================

# Logging
CRAWLER_LOG_LEVEL=INFO

# PostgreSQL (Silver & Gold Data Layer)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=16103
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=realestate_db

# MongoDB (Bronze Raw Data Layer)
MONGO_HOST=127.0.0.1
MONGO_PORT=16102
MONGO_USER=mongo_user
MONGO_PASSWORD=mongo_secure_password
MONGO_DB=realestate_raw

# Apache Kafka (Streaming Pipeline)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:16100
KAFKA_RAW_TOPIC=realestate.raw_events
KAFKA_DLQ_TOPIC=realestate.dlq_events

# Kafka Consumer Groups
KAFKA_GROUP_RAW_WRITER=bds_bronze_mongo_group
KAFKA_GROUP_CLEAN_PROCESSOR=bds_clean_processor_group
KAFKA_GROUP_DLQ_WRITER=bds_dlq_writer_group
KAFKA_DLQ_FLUSH_TIMEOUT=5.0
